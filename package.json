{
  "name": "office-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.17.0" },
  "scripts": {
    "start": "node src/server.mjs",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1 -Stop",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  }
}
